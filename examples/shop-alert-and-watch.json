    {
      "parameters": {
        "authentication": "oAuth2",
        "script": {
          "__rl": true,
          "mode": "address",
          "value": "reduck/king-jouet.com/add_to_cart"
        },
        "args": {
          "mappingMode": "defineBelow",
          "value": {
            "url": "={{ $('Product').all()[$itemIndex].json.url }}",
            "quantity": "={{ $('Config').first().json.quantity }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "url",
              "displayName": "url",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": false
            },
            {
              "id": "quantity",
              "displayName": "quantity",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": false
            }
          ]
        },
        "browser": "extension",
        "deviceId": "extension",
        "simplify": true
      },
      "id": "65ecb6f8-1377-50c5-affd-fc62a4af992b",
      "name": "Add To Cart",
      "type": "@reduck-ai/n8n-nodes-reduck.reduck",
      "typeVersion": 1,
      "position": [
        1760,
        -120
      ],
      "credentials": {},
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.notify_webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'Added to your cart (' + $('Product').all()[$itemIndex].json.source + '): ' + ($json.result ? $json.result.lines.map((l) => l.quantity + ' x ' + l.name).join(', ') + '. Cart: ' + $json.result.count + ' items, ' + $json.result.total + ' EUR. ' : 'it could not be added: ' + ($json.error ?? 'unknown error') + '. ') + $('Product').all()[$itemIndex].json.url }) }}",
        "options": {}
      },
      "id": "0d080664-ff77-571e-8b3a-9678d330c42c",
      "name": "Notify Added",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.notify_webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'Needs you (' + $('Product').all()[$itemIndex].json.source + '): over your price limit, or not available. ' + $('Product').all()[$itemIndex].json.url }) }}",
        "options": {}
      },
      "id": "a31a9c75-aecb-55b3-9b45-6a4168ca1794",
      "name": "Notify Needs You",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        120
      ]
    }
  ],
