      "name": "Check Product",
      "type": "@reduck-ai/n8n-nodes-reduck.reduck",
      "typeVersion": 1,
      "position": [
        1320,
        0
      ],
      "credentials": {},
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "52246a2c-4edf-5476-a8ee-c07f1704fc80",
              "leftValue": "={{ $json.result?.price != null && $json.result.price <= $('Config').first().json.max_price && $json.result.can_add_to_cart === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b5d210d5-9485-5139-852a-0f71827c71bf",
      "name": "Under Limit And Available",
