              "id": "url",
              "name": "url",
              "type": "string",
              "value": "={{ $json.url }}"
            },
            {
              "id": "source",
              "name": "source",
              "type": "string",
              "value": "={{ $json.source }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
